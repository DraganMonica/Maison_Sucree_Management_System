@model ProductDto

<form method="post">
    <input asp-for="ProductId" hidden />
    <div class=" pt-4">
        <div class="card container" style="border:1px solid #808080;">
            <div class="card-header row" style="border-radius:0; background-color:#fff5f5;">
                <div class="col-12 col-md-6">
                    <h1 style="color:#EB6864;">@Model.Name</h1>
                </div>
                <div class="col-12 col-md-6 text-end">
                    <h1 style="color:#212529;">@string.Format("{0:c}", @Model.Price)</h1>
                </div>
            </div>
            <div class="card-body">
                <div class="container rounded p-2">
                    <div class="row">
                        <div class="col-12 col-lg-4 p-1 text-center">
                            <img src="@Model.ImageUrl" style="border-radius:35px;" width="100%" class="rounded" />
                        </div>
                        <div class="col-12 col-lg-8">
                            <div class="row pl-3">

                                <div class="col-12">
                                    <span class="badge badge-pink px-4 py-2 fs-5 rounded-pill fw-semibold">
                                        @Model.CategoryName
                                    </span>
                                    <p class="text-secondary pt-3">@Html.Raw(Model.Description)</p>
                                </div>
                            </div>
                            <div class="row mx-0">
                                <input asp-for="Count" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer row bg-dark">
                <div class="col-12 col-md-6 pb-1 ">
                    <a asp-action="Index" class="btn btn-primary form-control btn-lg" style="height:50px;">Back to List</a>
                </div>
                <div class="col-12 col-md-6 ">
                    <button type="submit" class="btn btn-success form-control btn-lg" style="height:50px;">
                        Add to Cart
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
