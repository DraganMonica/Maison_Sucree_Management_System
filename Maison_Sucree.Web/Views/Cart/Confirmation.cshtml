@model int

<div class="text-center">
    <h1 style="color:#D16C87; letter-spacing:1px; padding-top:1rem;">
        Congratulations! You are one step closer to amazing food.
    </h1>

    <p style="color:#9E4B65; margin-bottom:1.5rem; font-size:1.4rem; line-height:1.6;">
        We have received your order & will be ready in 30 minutes during regular business hours!
    </p>

    <h4 style="color:#D16C87; font-weight:600; margin-bottom:2rem;">
        Order ID - @Model
    </h4>

    <img src="~/images/thank_you.png" width="80%" />
</div>
